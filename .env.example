# ==============================================================================
# YouTube Shorts Automation Studio Configuration
# ==============================================================================

# --- Google Gemini 2.0 Flash (Free Tier at aistudio.google.com) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Ssemble AI Clipping API (app.ssemble.com > Profile > API Keys) ---
SSEMBLE_API_KEY=sk_ssemble_your_key_here
SSEMBLE_BASE_URL=https://aiclipping.ssemble.com/api/v1
SSEMBLE_DEFAULT_TEMPLATE=hormozi1

# --- Free Stock Footage Providers ---
# Get free key at https://www.pexels.com/api/ (20,000 req/month free)
PEXELS_API_KEY=your_pexels_api_key_here
# Optional secondary provider: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Neural Voice Narration (Microsoft Edge TTS) ---
# Preset voices: en-US-ChristopherNeural, en-US-GuyNeural, en-US-AriaNeural, en-US-JennyNeural
DEFAULT_VOICE=en-US-ChristopherNeural
VOICE_RATE=+10%
VOICE_PITCH=+0Hz

# --- YouTube Data API v3 (Google Cloud Console) ---
# Download Desktop OAuth credentials as config/client_secret.json
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secret.json
YOUTUBE_TOKEN_FILE=data/youtube_token.pickle
YOUTUBE_DEFAULT_PRIVACY=unlisted  # unlisted, private, public
YOUTUBE_CATEGORY_ID=27            # 27 = Education, 22 = People & Blogs, 28 = Sci-Tech

# --- Studio Web Dashboard ---
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
